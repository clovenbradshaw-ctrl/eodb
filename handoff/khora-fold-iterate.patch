+  for (const [k, cell] of [["frame-verdict", frameCell], ["quote-verdict", "DEF·Figure"]]) P.weave(pen, { cell: "DEF·Figure", kind: "kind", addr: `kind:${k}`, body: { name: k, cell, why: "a verdict on a khora nomination" } });
