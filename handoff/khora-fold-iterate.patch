+    const pairs = new Set([...live.values()].map((e) => `${e.addr}\u0000${e.cell}`)), heads = new Map();                                                  // addr -> [head entries over every cell]
+    for (const pair of pairs) { const [addr, cell] = pair.split("\u0000"); for (const id of P.heads(h, addr, cell)) if (live.has(id)) (heads.get(addr) ?? heads.set(addr, []).get(addr)).push(live.get(id)); }
+    for (const [addr, hs] of heads) {
