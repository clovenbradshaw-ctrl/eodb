diff --git a/native/the-fold/reading-standard.mjs b/native/the-fold/reading-standard.mjs
new file mode 100644
index 00000000..957dc6c8
--- /dev/null
+++ b/native/the-fold/reading-standard.mjs
@@ -0,0 +1,50 @@
+// the-fold/reading-standard.mjs — THE READING STANDARD, as data and as one function: what every door that reads a document must satisfy, and the ledger that makes a skipped layer visible.
+//
+// THE STANDARD IS A ROUND TRIP (R1 to R6) plus the rules every layer and smell must meet (L1 to L9). Each clause carries its STATUS and its evidence, and an executable test (native/tests/reading-standard.test.mjs): a clause the pipeline meets is a passing test, one it does not meet is a TODO test that turns green when it is fixed.
+//
+// WHY. The reading pipeline is not one thing (measured 2026-11-26): the canonical weft reader (readDocument / readToWeft), the ordered read, and the chat each read a document their own way, and a layer a language lacks is
+// SOMETIMES a typed gap (Russian: no_parser, "no dependency parser for rus") and SOMETIMES silent (the speaker rung's field is simply absent; an empty cast says nothing about why). A standard has to be checkable, so each clause here
+// has an executable test (native/tests/reading-standard.test.mjs): a clause a door meets is a passing test; one it does not meet is a TODO test that turns green when it is fixed. The standard does not hide non-conformance.
+//
+// The owner's rules for every smell and heuristic (2026-11-26) are clauses too: ablatable and contextual; nothing ships with a regression; signals stack in one joint model so uncertainty collapses; weights, not rules (survive casual speech and typos).
+export const STANDARD = Object.freeze([
+  // ── THE ROUND TRIP (the owner, 2026-11-26): meet anything, find its folded codec by surprise reduction, get it to EOT, transform it in EOT, output new EOT, and encode it through a codec back into the target language PROSIFIED; the codec carries the prosification rules ──
+  { id: "R1", rule: "MEET ANYTHING: the codec is found by SURPRISE REDUCTION, as a distribution over codecs (never a language switch), folded in on demand; a text no held codec explains is a typed gap that names the nearest codec.", status: "built for spaced scripts", evidence: "the-fold/codec-fold.mjs: codec found for 35 of 37 Genesis editions with a held grammar (95%), the same on clean, lowercase and typo'd text; GAP: unspaced scripts have no calibrated open-world term (Traditional Chinese still chooses Japanese at p = 1.00)" },
+  { id: "R2", rule: "DECODE: any held codec reads a text into EOT (EOTRich@1: content nodes, cube-addressed relations, markers; no word order, no surface form).", status: "exists", evidence: "janus nl-eot.mjs read() over 78 UD grammars; a licence-restricted codec is pointed at and vendored on first use" },
+  { id: "R3", rule: "TRANSFORM IN EOT: modify and reason on the EOT and output new EOT; nothing is done on the surface string.", status: "NOT BUILT as one EOT-to-EOT interface", evidence: "the Stage reasoner consumes atoms (kernel/stage.js), not EOT records; no EOT-to-EOT transform API found" },
+  { id: "R4", rule: "ENCODE AND PROSIFY: a target codec turns EOT into prose, and the codec INCLUDES the prosification rules (natural order, negation placement, punctuation, capitalisation, sentence boundaries, connectives), not only a form table.", status: "NOT BUILT: encode exists, prosification does not", evidence: "measured on 25 English sentences: surface identical to the original 16%; 13.8% of content nodes have no attested form; 'he had not' comes back 'he not had', 'It is a truth' comes back 'is it a truth'" },
+  { id: "R5", rule: "THE ROUND TRIP IS AN EOT FIXED POINT: for a sentence the codec fully attests (no gaps), decode(encode(decode(x))) has the same EOT as decode(x). A gap makes the loss typed, never silent.", status: "FAILS today", evidence: "fixed point for 24% of 25 English sentences (6 of 25); the conditional invariant (gap-free sentences only) is the todo test" },
+  { id: "R6", rule: "ANY LANGUAGE TO ANY LANGUAGE through EOT: no language is the hub; a content node crosses by a CORRESPONDENCE, and without one the node keeps its source lemma and is counted as the gap no_correspondence.", status: "partial", evidence: "nl-eot.mjs write() takes a lemmaMap; no weft translation exists (subagent report)" },
+  // ── THE RULES FOR EVERY LAYER AND EVERY SMELL ──
+  { id: "L1", rule: "EVERY LAYER IS RUN OR SKIPPED WITH A REASON: the entry carries a layer ledger; a layer a language lacks is a typed entry, never an absent field.", status: "built for the framed door", evidence: "readFramed's entry.layers (layerLedger below); the canonical readDocument still leaves speakerBindings absent and the cast empty without a reason" },
+  { id: "L2", rule: "EVERY LAYER IS ABLATABLE: it can be switched off on request, and the entry says it was ablated (unknown, never false).", status: "built for the frames layers", evidence: "readFramed({ ablate: ['quotes','speech'] })" },
+  { id: "L3", rule: "WEIGHTS, NOT RULES: a signal is a weight on one joint score and survives casual speech and typos; it is fitted on labels that do not share its origin; it ships only past an ablation gate with no regression; its answer carries an uncertainty that collapses as evidence agrees.", status: "built for name-smell", evidence: "adapters/text/name-smell.js; scripts/ablate-name-smell-loto.mjs" },
+  { id: "L4", rule: "THE LANGUAGE IS DECLARED OR HEARD, RECORDED, NEVER GUESSED: a language no held codec explains yields a typed gap and NO reading in the target pipeline (no fallback to English priors).", status: "built for readFramed; readDocument still reads an unheld language as English beside its unknown_language gap", evidence: "codec-fold.mjs; read-framed.mjs" },
+  { id: "L5", rule: "A MISSING PRIOR OR CODEC IS A REFUSAL THAT SAYS HOW TO GET IT, never a silent degrade.", status: "mostly", evidence: "gaps name vendor-ud-codec.mjs and the prior files" },
+  { id: "L6", rule: "ONE DOOR: every surface reads through the canonical entry; two doors that compute the same thing agree on gold, and their disagreement is measured.", status: "frames: one layer, two doors, 17 of 17 agree; the chat still builds its fold from its own reader and the two cast builders agree on only 0.73 of names", evidence: "tests/read-framed.test.mjs" },
+  { id: "L7", rule: "EVERYTHING WRITES TO THE PHAROS BY CELL AND KIND; derived state is a cache that can be deleted.", status: "NOT BUILT for frames and the round trip", evidence: "entry.frames is not woven" },
+  { id: "L8", rule: "NO SILENT DROP: every paragraph is read or reported with its reason.", status: "built", evidence: "chat/ingest.mjs setAside" },
+  { id: "L9", rule: "CODECS ARE CONTINUOUS: a language is a point in a continuum of tables and priors loaded when needed, so a new language lowers surprise instead of switching a branch.", status: "first piece built (R1); the continuity of tables across related languages is not", evidence: "related languages already explain each other (Norwegian under Danish reaches 0.76 to 0.80 coverage)" },
+]);
+
+/** the layers every read is accountable for, in the order the pipeline runs them */
+export const STANDARD_LAYERS = Object.freeze(["language", "cut", "parse", "cast", "pronouns", "clauses", "speakers", "frames.quotes", "frames.speech"]);
+
+/**
+ * layerLedger(entry, { stem, quotes, speech, ablate }) -> [{ layer, ran: true | false | "ablated", why }]  one row per STANDARD layer, derived from the entry itself plus what the frames layer knew.
+ * It NAMES a silent skip: a field the canonical reader leaves absent (the speaker rung is English-only: read-core.mjs:577) becomes a row that says so. Nothing is inferred beyond the entry's own fields and gaps.
+ */
+export function layerLedger(entry, { stem = entry?.language?.stem ?? null, quotes = null, speech = null, ablate = [] } = {}) {
+  const gaps = (entry?.gaps ?? []).map((g) => g.gap ?? g), has = (g) => gaps.includes(g), row = (layer, ran, why = null) => ({ layer, ran, why });
+  const out = [];
+  out.push(entry?.language ? row("language", true, `${entry.language.source ?? "recorded"}${has("unknown_language") ? "; unknown_language (read with default priors)" : ""}${has("language_default") ? "; language_default" : ""}`) : row("language", false, "no language on the entry"));
+  out.push(Array.isArray(entry?.sentences) && entry.sentences.length ? row("cut", true) : row("cut", false, entry?.skipped ?? "no sentences"));
+  out.push(Array.isArray(entry?.parse) && entry.parse.length ? row("parse", true) : row("parse", false, has("no_parser") ? "no_parser: no UD codec filed for this language (reading.js::rowsOfFor says how to vendor it)" : "rows were not requested or the parse is empty"));
+  out.push(Array.isArray(entry?.cast) ? row("cast", true, entry.cast.length ? null : "ran and found nobody: the entry does not say why (a caseless script, a missing prior and a text with no names look alike)") : row("cast", false, "no cast on the entry"));
+  out.push(Array.isArray(entry?.pronounsPresence) || Array.isArray(entry?.pronouns) ? row("pronouns", true, has("pronoun_presence_no_register") ? "pronoun_presence_no_register: no measured register for this language" : null) : row("pronouns", false, "no pronoun layer on the entry"));
+  out.push(Array.isArray(entry?.clauses) ? row("clauses", true) : row("clauses", false, entry?.quality?.clauses?.gap ?? "no clause tree on the entry"));
+  out.push(Array.isArray(entry?.speakerBindings) ? row("speakers", true) : entry?.speakerBindings?.gap ? row("speakers", false, entry.speakerBindings.gap) : row("speakers", false, stem && stem !== "eng" ? "the speaker rung is English-only (read-core.mjs:577): the field is absent, not typed, on the canonical entry" : "no speaker bindings on the entry"));
+  out.push(ablate.includes("quotes") ? row("frames.quotes", "ablated", "switched off on request: frames are unknown, not false") : quotes && quotes.gap ? row("frames.quotes", false, quotes.gap) : row("frames.quotes", quotes ? true : false, quotes ? null : "frames were not computed"));
+  out.push(ablate.includes("speech") ? row("frames.speech", "ablated", "switched off on request: reported is unknown, not false") : speech && speech.gap ? row("frames.speech", false, speech.gap.gap ?? String(speech.gap)) : row("frames.speech", speech ? true : false, speech ? null : "frames were not computed"));
+  return out;
+}
