From 24d1dab151093f6880031b6c106b14e507ac3b56 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 25 Nov 2026 22:30:53 +0000
Subject: [PATCH 07/13] quote-frames: a codec registers its own table; marks
 the table does not know are a typed gap that lists them

Found by running Genesis in 65 languages: 35 editions mark no quotation at all, 25 mark them and had no table,
and the Spanish table found 0 of 224 straight-quote spans without saying so. registerQuoteTable (a built-in cannot be
replaced), marks_outside_table and no_quote_table now carry the marks seen; straight quotes read in fra/spa/ita/rus.
ingestDocument reports the lang it used. 28 tests.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01AP2eRC5CScKTs8ZE4Wpdoe
---
 native/chat/ingest.mjs            |  4 +++-
 native/chat/quote-frames.js       | 27 +++++++++++++++++++++------
 native/chat/quote-frames.test.mjs | 19 +++++++++++++++++++
 3 files changed, 43 insertions(+), 7 deletions(-)

diff --git a/native/chat/ingest.mjs b/native/chat/ingest.mjs
index c1dccd9..57ea80b 100644
--- a/native/chat/ingest.mjs
+++ b/native/chat/ingest.mjs
@@ -23,10 +23,12 @@ const paragraphsOf = (text) => {
 };
 const bracketed = (p) => p.startsWith("[") && p.endsWith("]");   // a note in the source's own markup (an illustration credit), not a sentence of the text
 
+// `lang` is the language of the QUOTATION CONVENTIONS, and the result says which one was used (`lang`): the chat reads English only today, so its thread declares English; a caller reading another
+// language passes its own, and a language with no table is a typed gap on every frame, never an English reading.
 export async function ingestDocument(thread, text, { onRead = null, lang = "eng" } = {}) {
   const paras = paragraphsOf(text);
   if (!paras.length) return { paragraphs: 0, read: 0, sentences: 0, facts: 0, setAside: [], frames: [], quoteGaps: [], gap: "empty_text" };
-  const res = { paragraphs: paras.length, read: 0, sentences: 0, facts: 0, setAside: [], frames: [], quoteGaps: [], gap: null };
+  const res = { lang, paragraphs: paras.length, read: 0, sentences: 0, facts: 0, setAside: [], frames: [], quoteGaps: [], gap: null };
