+  const th = await mk(); const r = await ingestDocument(th, KJV.join("\n\n"));
+  for (const f of r.frames.filter((x) => x.para === 3 || x.para === 5)) assert.notEqual(f.reported, true, `${f.para}:${f.form}`);
+});
