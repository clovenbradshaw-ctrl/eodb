diff --git a/native/adapters/text/name-smell.js b/native/adapters/text/name-smell.js
new file mode 100644
index 0000000..deef039
--- /dev/null
+++ b/native/adapters/text/name-smell.js
@@ -0,0 +1,51 @@
+// adapters/text/name-smell.js — DOES A SURFACE SMELL LIKE A NAME? Measured, never listed.
+//
+// WHY. The canonical reader and the chat each decide who is in the cast by capitalisation, and each fails differently on the same text (measured 2026-11-26, 71 names agreed, 8 only canonical, 18 only chat):
+// sentence-openers ("Yea", "Hast", "Shalt", "Wherefore", "See", "Shed") are taken for names, and so are capitalised common words ("Day", "Seas", "Heaven", "Man"). The pinned emergent smell was tried and is the
+// wrong instrument here: its vocabulary is 671 word types and it knew none of 22 real names.
+//
+// THE RULE, three measured things and no word list:
+//   1. A word the reader's PART-OF-SPEECH PRIOR knows only as a closed class (pronoun, auxiliary, determiner, adposition, conjunction, particle, interjection, number, symbol) is never a name ("I", "I’m", "And").
+//      The closed classes are the UD universal taxonomy, not a language's words; an open class (noun, verb, adjective) is NOT vetoed, because "Kitty" and "Rose" are nouns too.
+//   2. A word that also occurs LOWERCASE in the same text is a common word ("Day": "the day went"; "Man": "the man"; "Heaven", "Earth", "Seas").
+//   3. A name is capitalised somewhere that is NOT a sentence start. Capitalised only because it opens a sentence is UNKNOWN, never a name; so is a word the text never uses.
+// A title with its name is judged on the name ("Mrs. Long" by "Long"); a bare dotted abbreviation ("Mr.") is not a being. The prior is optional: without it the verdict still stands and carries a typed gap.
+// KNOWN LIMITS: a person whose name is also a common word the same text uses ("Rose" and "rose") is lost; a name only ever seen at sentence starts is unknown; judged per text, so it needs a text long enough to show a word both ways.
+// nameSmell({ surface, text, sentenceStarts, pos }) -> { verdict: "name"|"not_name"|"unknown", why, capMid, capInitial, lower, prior?, priorGap? }
+//   sentenceStarts  Set of character offsets where a sentence starts: the READER's own (entry.parse[].offset); sentenceStartsOf() is a naive fallback that knows no abbreviation
+//   pos             the part-of-speech prior's forms: lowercase form -> { UPOS: count } (janus/priors/pos-eng.json)
+//   posAt           optional Map(character offset -> UPOS): the READER's own tag for the token in context (entry.parse rows). It can only REMOVE a name: a capital after a comma that opens an unmarked speech
+//                   ("said unto them, Shed no blood") looks mid-sentence by position, and the parser tags it VERB. All-caps tokens ("LORD") are their own word, so the lowercase test does not apply to them.
+export const NAME_SMELL_SCHEMA = "NameSmell@1";
+const CLOSED = new Set(["PRON", "AUX", "DET", "ADP", "CCONJ", "SCONJ", "PART", "INTJ", "PUNCT", "NUM", "SYM"]);
+const OPENING = "“«„‘\"'(";
+const isLetter = (c) => c !== undefined && c.toLowerCase() !== c.toUpperCase();
+
+/** a naive fallback: the start, each paragraph start, and the first non-space after . ! ? (no abbreviation knowledge: pass the reader's own offsets when there are any) */
+export function sentenceStartsOf(text) {
+  const t = String(text ?? ""), out = new Set([0]);
+  for (let i = 0; i < t.length; i++) {
+    if (t[i] === "\n" && t[i + 1] === "\n") { let j = i + 2; while (t[j] === "\n" || t[j] === " ") j++; out.add(j); }
+    if (".!?".includes(t[i]) && (t[i + 1] === " " || t[i + 1] === "\n" || OPENING.includes(t[i + 1] ?? ""))) { let j = i + 1; while (t[j] === " " || t[j] === "\n") j++; out.add(j); }
+  }
+  return out;
+}
+const occurrences = (t, w) => { const at = []; let i = t.indexOf(w); while (i >= 0) { if (!isLetter(t[i - 1]) && !isLetter(t[i + w.length])) at.push(i); i = t.indexOf(w, i + 1); } return at; };
+
+export function nameSmell({ surface, text, sentenceStarts, pos, posAt }) {
+  const T = String(text ?? ""), words = String(surface ?? "").trim().split(" ").filter(Boolean), head = words[words.length - 1] ?? "", out = (verdict, why, x = {}) => ({ schema: NAME_SMELL_SCHEMA, surface, head, verdict, why, capMid: 0, capInitial: 0, lower: 0, ...x });
+  if (!head) return out("unknown", "no surface");
+  if (head.endsWith(".")) return out("not_name", "a dotted abbreviation is not a being");
+  if (head === head.toLowerCase()) return out("not_name", "not capitalised");
+  const lw = head.toLowerCase(), e = pos ? pos[lw] : undefined, priorGap = pos ? null : "no_pos_prior";
+  let prior; if (e) { const top = Object.entries(e).sort((a, b) => b[1] - a[1])[0]; prior = { top: top[0], n: Object.values(e).reduce((a, b) => a + b, 0) }; }
+  const starts = sentenceStarts ?? sentenceStartsOf(T), at = occurrences(T, head), isInitial = (i) => starts.has(i) || (OPENING.includes(T[i - 1] ?? "") && starts.has(i - 1));
+  const capInitial = at.filter(isInitial).length, capMid = at.length - capInitial, lower = occurrences(T, lw).length, ev = { capMid, capInitial, lower, ...(prior ? { prior } : {}), ...(priorGap ? { priorGap } : {}) };
+  if (prior && CLOSED.has(prior.top)) return out("not_name", `the prior knows it as ${prior.top}, a closed class`, ev);
+  const allCaps = head.length > 1 && head === head.toUpperCase();
+  if (lower > 0 && !allCaps) return out("not_name", `it also occurs lowercase in the text (${lower}×): a common word`, ev);
+  if (capMid >= 1 && posAt) { const tags = at.filter((i) => !isInitial(i)).map((i) => posAt.get(i)).filter(Boolean); if (tags.length && !tags.some((u) => u === "PROPN" || u === "X")) { const top = [...new Set(tags)].join("/"); return out("not_name", `the parser tags it ${top} in context (${tags.length}×), never a proper noun`, { ...ev, tags }); } }
+  if (capMid >= 1) return out("name", `capitalised away from a sentence start (${capMid}×) and never lowercase`, ev);
+  if (capInitial >= 1) return out("unknown", "capitalised only where a sentence begins", ev);
+  return out("unknown", "not in the text", ev);
+}
diff --git a/native/adapters/text/name-smell.test.mjs b/native/adapters/text/name-smell.test.mjs
new file mode 100644
index 0000000..b17027e
--- /dev/null
+++ b/native/adapters/text/name-smell.test.mjs
@@ -0,0 +1,55 @@
+// adapters/text/name-smell.test.mjs — does a surface SMELL like a name? Measured from the text's own casing and the reader's part-of-speech prior; no word list, no typed threshold.
+// Written before the module; each test says what would falsify it.
+import test from "node:test"; import assert from "node:assert/strict";
+import { nameSmell, sentenceStartsOf } from "./name-smell.js";
+
+// a prior in the shape of janus/priors/pos-eng.json forms: lowercase form -> { UPOS: count }
+const POS = { i: { PRON: 900 }, "i’m": { PRON: 40 }, and: { CCONJ: 999 }, the: { DET: 999 }, day: { NOUN: 170, PROPN: 8 }, man: { NOUN: 36 }, see: { VERB: 205 }, yea: { INTJ: 3 }, kitty: { NOUN: 3, PROPN: 2 }, bennet: undefined, hast: undefined, shalt: undefined, wherefore: undefined };
+const text = "Kitty coughed. Day came and the day went. Yea, said Bennet. See the man and the man saw Kitty. I think Bennet knew. Hast thou eaten? Shalt thou go? Wherefore did Mrs. Long call Bennet? Bennet saw Long.";
+const S = sentenceStartsOf(text);
+const v = (surface, o = {}) => nameSmell({ surface, text, sentenceStarts: S, pos: POS, ...o });
+
+test("a surface capitalised away from a sentence start and never lowercase is a name, even when the prior has never seen it", () => {
+  const r = v("Bennet"); assert.equal(r.verdict, "name"); assert.ok(r.capMid >= 1); assert.equal(r.lower, 0);
+});
+test("an open-class word the prior knows as a noun is still a name when the text capitalises it everywhere ('Kitty')", () => { assert.equal(v("Kitty").verdict, "name"); });
+test("a word that also occurs lowercase in the same text is a common word, not a name ('Day', 'Man')", () => {
+  assert.equal(v("Day").verdict, "not_name"); assert.match(v("Day").why, /lowercase/); assert.equal(nameSmell({ surface: "Man", text: "Man was made. The man left.", sentenceStarts: sentenceStartsOf("Man was made. The man left."), pos: POS }).verdict, "not_name");
+});
+test("TRAP: a word capitalised ONLY because it opens a sentence is unknown, never a name ('Yea', 'Hast', 'Shalt', 'Wherefore', 'See')", () => {
+  for (const w of ["Yea", "Hast", "Shalt", "Wherefore", "See"]) { const r = v(w); assert.notEqual(r.verdict, "name", w); }
+  assert.equal(v("Hast").verdict, "unknown"); assert.equal(v("Wherefore").verdict, "unknown");
+});
+test("TRAP: a closed-class word the prior knows (a pronoun, a conjunction) is never a name, however it is capitalised ('I', 'I’m', 'And')", () => {
+  const t = "Then I went. And I saw. Bennet said I’m here. I stayed.", s = sentenceStartsOf(t);
+  for (const w of ["I", "And", "I’m"]) assert.equal(nameSmell({ surface: w, text: t, sentenceStarts: s, pos: POS }).verdict, "not_name", w);
+});
+test("a title with its name is judged on the name: 'Mrs. Long' by 'Long'; a bare dotted title is not a being ('Mr.')", () => {
+  assert.equal(v("Mrs. Long").verdict, "name");
+  assert.equal(nameSmell({ surface: "Mr.", text: "Mr. Bennet came. Mr. Bennet left.", sentenceStarts: sentenceStartsOf("Mr. Bennet came. Mr. Bennet left."), pos: POS }).verdict, "not_name");
+});
+test("a surface that is not in the text at all is unknown, never a name by default; no prior is a typed gap on the verdict, not a crash", () => {
+  assert.equal(v("Zebulun").verdict, "unknown");
+  const r = nameSmell({ surface: "Bennet", text, sentenceStarts: S, pos: null }); assert.equal(r.verdict, "name"); assert.equal(r.priorGap, "no_pos_prior");
+});
+test("the verdict carries its evidence, so a reader can see why", () => { const r = v("Bennet"); assert.ok("capMid" in r && "capInitial" in r && "lower" in r && "why" in r); });
+
+// ── found by running it over both builders' casts on Genesis and Pride and Prejudice (2026-11-26) ──
+test("FOUND: an ALL-CAPS token is its own word: 'LORD' (the divine name) is not vetoed by the common word 'lord' in the same text", () => {
+  const t = "And the LORD said unto Pharaoh, my lord, I will go. The LORD spake. A lord of Egypt came.", s = sentenceStartsOf(t);
+  assert.equal(nameSmell({ surface: "LORD", text: t, sentenceStarts: s, pos: POS }).verdict, "name");
+  assert.equal(nameSmell({ surface: "Lord", text: "Then Lord Byron came. The lord left.", sentenceStarts: sentenceStartsOf("Then Lord Byron came. The lord left."), pos: POS }).verdict, "not_name", "title-case still meets the lowercase test");
+});
+test("FOUND: the reader's own tag for the token in context decides what position cannot: a capital after the comma that opens an unmarked speech ('said unto them, Shed no blood') is not a name when the parser tags it VERB", () => {
+  const t = "And Reuben said unto them, Shed no blood. Reuben went. And Judah said, Wherefore go we? Judah stayed.", s = sentenceStartsOf(t);
+  const at = (w, n = 0) => { let i = -1; for (let k = 0; k <= n; k++) i = t.indexOf(w, i + 1); return i; };
+  const posAt = new Map([[at("Reuben"), "PROPN"], [at("Shed"), "VERB"], [at("Reuben", 1), "PROPN"], [at("Judah"), "PROPN"], [at("Wherefore"), "ADV"], [at("Judah", 1), "PROPN"]]);
+  assert.equal(nameSmell({ surface: "Shed", text: t, sentenceStarts: s, pos: POS, posAt }).verdict, "not_name"); assert.match(nameSmell({ surface: "Shed", text: t, sentenceStarts: s, pos: POS, posAt }).why, /VERB in context/);
+  assert.equal(nameSmell({ surface: "Wherefore", text: t, sentenceStarts: s, pos: POS, posAt }).verdict, "not_name");
+  assert.equal(nameSmell({ surface: "Reuben", text: t, sentenceStarts: s, pos: POS, posAt }).verdict, "name");
+  assert.equal(nameSmell({ surface: "Shed", text: t, sentenceStarts: s, pos: POS }).verdict, "name", "without the contextual tags the verdict is the casing verdict, unchanged");
+});
+test("the contextual tag only ever REMOVES a name: a token the parser tags PROPN is not made a name by the tag alone (a sentence-initial one stays unknown)", () => {
+  const t = "Yea, said Bennet. Yea went on.", s = sentenceStartsOf(t); const posAt = new Map([[0, "PROPN"], [t.indexOf("Yea went"), "PROPN"]]);
+  assert.equal(nameSmell({ surface: "Yea", text: t, sentenceStarts: s, pos: { yea: undefined }, posAt }).verdict, "unknown");
+});
