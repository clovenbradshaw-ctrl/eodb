+  const p = speechVerbFromActPrior(prior); assert.equal(p.gap, null); assert.equal(p.isSpeech("say"), true); assert.equal(p.isSpeech("tell"), true); assert.equal(p.isSpeech("cry"), true); assert.equal(p.isSpeech("run"), false);
